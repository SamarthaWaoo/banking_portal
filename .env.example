SECRET_KEY=change-this-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourapp.onrender.com
# ============================================================
#  SpendSmart Bank — Environment Variables
#  Copy this file to  .env  and fill in your values.
#  Never commit .env to version control.
# ============================================================

# Django
SECRET_KEY=django-insecure-CHANGE_THIS_TO_A_RANDOM_STRING
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────
# Set DB_ENGINE=sqlite3 to use SQLite instead (no other vars needed)
DB_ENGINE=mysql
DB_NAME=banksuite
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Admin registration protection ───────────────────────────────────────
# Anyone trying to create an admin account must supply this exact key.
# Leave blank to DISABLE admin registration entirely (recommended for production).
ADMIN_REGISTRATION_SECRET=


